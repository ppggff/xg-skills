 "write": [
  {
   "name": "tick writes the done date",
   "op": "tick",
   "before": "- [ ] a ➕ 2026-10-01 09:00",
   "line": 0,
   "done": true,
   "today": "2026-10-13",
   "after": "- [x] a ➕ 2026-10-01 09:00 ✅ 2026-10-13"
  },
  {
   "name": "untick takes the trailing done date away",
   "op": "tick",
   "before": "- [x] a ✅ 2026-10-07 12:00:09",
   "line": 0,
   "done": false,
   "today": "2026-10-13",
   "after": "- [ ] a"
  },
  {
   "name": "tick keeps indent, marker and spacing",
   "op": "tick",
   "before": "x\n  *   [ ] sub",
   "line": 1,
   "done": true,
   "today": "2026-10-13",
   "after": "x\n  *   [x] sub ✅ 2026-10-13"
  },
  {
   "name": "append to a file without a trailing newline",
   "op": "append",
   "before": "# inbox\n\n- [ ] old",
   "text": "new",
   "project": "p",
   "link": "",
   "stamp": "2026-10-13 14:05:33",
   "after": "# inbox\n\n- [ ] old\n- [ ] new @p ➕ 2026-10-13 14:05:33\n",
   "file": "inbox.md"
  },
  {
   "name": "append to a missing file titles it after its name",
   "op": "append",
   "before": "",
   "text": "new",
   "project": "",
   "link": "",
   "stamp": "2026-10-13 14:05:33",
   "after": "# inbox\n\n- [ ] new ➕ 2026-10-13 14:05:33\n",
   "file": "inbox.md"
  },
  {
   "name": "a project tag already in the text is not added again",
   "op": "append",
   "before": "# work\n",
   "text": "ask @p about it",
   "project": "p",
   "link": "",
   "stamp": "2026-10-13 14:05:33",
   "after": "# work\n- [ ] ask @p about it ➕ 2026-10-13 14:05:33\n",
   "file": "work.md"
  },
  {
   "name": "a longer tag is not the project tag",
   "op": "append",
   "before": "# work\n",
   "text": "see @p-old",
   "project": "p",
   "link": "",
   "stamp": "2026-10-13 14:05:33",
   "after": "# work\n- [ ] see @p-old @p ➕ 2026-10-13 14:05:33\n",
   "file": "work.md"
  },
  {
   "name": "the link comes after the project tag",
   "op": "append",
   "before": "# inbox\n",
   "text": "x",
   "project": "p",
   "link": "xg-skills/048",
   "stamp": "2026-10-13 14:05:33",
   "after": "# inbox\n- [ ] x @p [[xg-skills/048]] ➕ 2026-10-13 14:05:33\n",
   "file": "inbox.md"
  },
  {
   "name": "ticking again replaces the done date",
   "op": "tick",
   "before": "- [x] a ✅ 2026-10-01",
   "line": 0,
   "done": true,
   "today": "2026-10-13",
   "after": "- [x] a ✅ 2026-10-13"
  },
  {
   "name": "untick takes only the trailing done date",
   "op": "tick",
   "before": "- [x] cost ✅2024-01-01 receipt ✅ 2026-10-07",
   "line": 0,
   "done": false,
   "today": "2026-10-13",
   "after": "- [ ] cost ✅2024-01-01 receipt"
  },
  {
   "name": "an ordered item ticks in place",
   "op": "tick",
   "before": "1. [ ] b",
   "line": 0,
   "done": true,
   "today": "2026-10-13",
   "after": "1. [x] b ✅ 2026-10-13"
  },
  {
   "name": "line breaks in appended text become continuations, whatever their kind",
   "op": "append",
   "file": "inbox.md",
   "before": "# inbox\n",
   "text": "first\r\nsecond third",
   "project": "",
   "link": "",
   "stamp": "2026-10-13 14:05:33",
   "after": "# inbox\n- [ ] first ➕ 2026-10-13 14:05:33\n    second\n    third\n"
  }
 ]
}
