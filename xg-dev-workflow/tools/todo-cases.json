{
 "_about": "Shared todo-format cases (see todo-format.md). parse runs on todo.py and on the viewer's sv.js; write runs on todo.py, the only writer.",
 "parse": [
  {
   "name": "marks and tags",
   "text": "- [ ] ship it @p ➕ 2026-10-13 09:00:01 📅 2026-10-20 ⏫\n- [x] filed #old ✅ 2026-10-12",
   "items": [
    {
     "line": 0,
     "done": false,
     "depth": 0,
     "tags": [
      "p"
     ],
     "key": "ship it @p",
     "created": "2026-10-13 09:00:01",
     "due": "2026-10-20",
     "done_date": "",
     "priority": 1,
     "progress": null,
     "more": []
    },
    {
     "line": 1,
     "done": true,
     "depth": 0,
     "tags": [
      "old"
     ],
     "key": "filed #old",
     "created": "",
     "due": "",
     "done_date": "2026-10-12",
     "priority": 0,
     "progress": null,
     "more": []
    }
   ]
  },
  {
